{
  "name": "stdocs",
  "version": "0.1.0",
  "description": "Static Documentation with Markdown",
  "keywords": [
    "stdocs",
    "stl8",
    "sdcl",
    "static-site-generator",
    "documentation",
    "documentation generator",
    "cli",
    "markdown"
  ],
  "homepage": "https://github.com/Spectra010s/stdocs#readme",
  "bugs": {
    "url": "https://github.com/Spectra010s/stdocs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spectra010s/stdocs.git",
    "directory": "packages/stdocs"
  },
  "license": "MIT",
  "author": "Spectra010s",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
