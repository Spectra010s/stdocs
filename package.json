{
  "name": "stdocs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Static Documentation Generator with SDCL",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/*",
    "test": "npm run test -w packages/* --if-present",
    "dev": "npm run dev -w packages/stdocs"
  },
  "keywords": [
    "stdocs",
    "stl8",
    "sdcl",
    "static-site-generator",
    "documentation"
  ],
  "author": "Spectra010s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spectra010s/stdocs.git"
  },
  "homepage": "https://github.com/Spectra010s/stdocs#readme",
  "bugs": {
    "url": "https://github.com/Spectra010s/stdocs/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
